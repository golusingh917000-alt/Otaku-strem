<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
            <title>Otaku Stream PRO | Seasons Engine</title>
                <style>
                        :root { --bg: #0a0a0c; --card: #141419; --orange: #FF6600; --text: #ffffff; --gray: #a0a0a5; }
                                body { background: var(--bg); color: var(--text); font-family: sans-serif; margin: 0; padding: 12px; display: flex; flex-direction: column; align-items: center; }
                                        .v-wrap { position: relative; width: 100%; max-width: 800px; background: #000; border-radius: 12px; overflow: hidden; border: 2px solid #23232a; box-shadow: 0 0 15px rgba(255, 102, 0, 0.2); }
                                                video { width: 100%; display: block; }
                                                        video::-webkit-media-controls { display: none !important; }
                                                                .ctrls { position: absolute; bottom: 0; left: 0; right: 0; background: linear-gradient(transparent, rgba(10,10,12,0.95)); display: flex; flex-direction: column; padding: 12px; gap: 8px; }
                                                                        .tm-line { height: 6px; width: 100%; background: rgba(255,255,255,0.2); cursor: pointer; border-radius: 3px; }
                                                                                .tm-bar { height: 100%; width: 0%; background: var(--orange); border-radius: 3px; box-shadow: 0 0 6px var(--orange); }
                                                                                        .btns { display: flex; justify-content: space-between; }
                                                                                                .btn { background: none; border: none; color: #fff; font-weight: bold; cursor: pointer; font-size: 13px; text-transform: uppercase; }
                                                                                                        .btn:hover { color: var(--orange); }
                                                                                                                .now-playing { width: 100%; max-width: 800px; margin: 15px 0; background: var(--card); border-radius: 10px; padding: 15px; box-sizing: border-box; border: 1px solid #23232a; }
                                                                                                                        .now-playing h2 { margin: 0 0 5px 0; font-size: 18px; color: #fff; }
                                                                                                                                .now-playing p { margin: 0; font-size: 13px; color: var(--gray); }
                                                                                                                                        .seasons-container { width: 100%; max-width: 800px; display: flex; flex-direction: column; gap: 25px; margin-bottom: 50px; }
                                                                                                                                                .season-title { color: var(--orange); font-size: 18px; font-weight: bold; text-transform: uppercase; letter-spacing: 1px; border-left: 4px solid var(--orange); padding-left: 8px; margin: 0; }
                                                                                                                                                        .episode-row { display: flex; gap: 15px; overflow-x: auto; padding-bottom: 10px; width: 100%; scroll-behavior: smooth; }
                                                                                                                                                                .episode-row::-webkit-scrollbar { height: 4px; }
                                                                                                                                                                        .episode-row::-webkit-scrollbar-thumb { background: var(--orange); border-radius: 10px; }
                                                                                                                                                                                .ep-card { min-width: 160px; max-width: 160px; background: var(--card); border-radius: 8px; border: 1px solid #23232a; overflow: hidden; display: flex; flex-direction: column; justify-content: space-between; transition: 0.2s; }
                                                                                                                                                                                        .ep-card:hover { border-color: var(--orange); }
                                                                                                                                                                                                .ep-thumb { width: 100%; height: 90px; background: #23232a; display: flex; align-items: center; justify-content: center; font-size: 12px; color: var(--orange); font-weight: bold; position: relative; }
                                                                                                                                                                                                        .ep-details { padding: 8px; display: flex; flex-direction: column; gap: 6px; }
                                                                                                                                                                                                                .ep-name { font-size: 13px; font-weight: bold; color: #fff; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin: 0; }
                                                                                                                                                                                                                        .action-grid { display: flex; gap: 5px; }
                                                                                                                                                                                                                                .play-ep-btn { background: var(--orange); color: #fff; border: none; padding: 5px; font-size: 11px; font-weight: bold; border-radius: 4px; cursor: pointer; flex: 2; text-transform: uppercase; }
                                                                                                                                                                                                                                        .dl-ep-btn { background: #23232a; color: var(--orange); border: 1px solid var(--orange); padding: 5px; font-size: 11px; font-weight: bold; border-radius: 4px; cursor: pointer; flex: 1; text-align: center; text-decoration: none; }
                                                                                                                                                                                                                                                .dl-ep-btn:hover { background: var(--orange); color: #fff; }
                                                                                                                                                                                                                                                    </style>
                                                                                                                                                                                                                                                    </head>
                                                                                                                                                                                                                                                    <body>
